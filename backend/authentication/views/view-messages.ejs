<!DOCTYPE html>
<html lang="en">
<%- include('./partials/head.ejs') %>
<body>
	<h1>Messages</h1>
	<a href="/messages/new">New message</a>
	<ul>
		<% (locals.messages || []).forEach((message) => { %>
			<li>
				<h2><%= message.title %></h2>
				<p><%= message.message %></p>
				<% if (message.username) { %>
					<p><%= message.username %></p>
				<% } %>
			</li>
		<% }) %>
	</ul>
</body>
</html>
