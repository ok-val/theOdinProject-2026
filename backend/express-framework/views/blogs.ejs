<!DOCTYPE html>
<html lang="en">
<%- include('partials/head.ejs') %>
<body>
  <%- include('./partials/nav.ejs') %>

  <h1><%= title %></h1>

  <% if (blogs.length > 0) { %>
    <% blogs.forEach(blog => { %>
      <h3> <%= blog.title %></h3>
      <p> <%= blog.author %></p>
      <p> <%= blog.content %></p>
    <% }) %>
  <% } else { %>
    <p>There are no blogs to display...</p>
  <% } %>
</body>
</html>