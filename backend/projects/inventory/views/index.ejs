<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Home</title>
</head>
<body>
  <h1>Jazz records inventory</h1>
  <form action="/" method="get">
    <label for="q" hidden>Query</label>
    <input type="text" name="q" placeholder="Search query"/>
    <button type="submit">Search</button>
  </form>
  <% if (qRes) {%>
    <ul>
      <% qRes.forEach((res) => {%>
        <li><%= res.name%>, <%= res.year%></li>
      <% }) %>
    </ul>
  <% } %> 
</body>
</html>