<!DOCTYPE html>
<html lang="en">
  <%- include('./partials/head.ejs')%>
<body>
  <h1>Jazz Records Inventory</h1>

  <form action="/" method="get">
    <label for="qRecord" hidden>Record name</label>
    <input type="text" name="qRecord" placeholder="Record name"/>
    
    <label for="qArtist" hidden>Artist name</label>
    <input type="text" name="qArtist" placeholder="Artist name"/>

    <label for="qYear" hidden>Artist name</label>
    <input type="text" name="qYear" placeholder="Year"/>

    <label for="qInstrument" hidden>Artist name</label>
    <input type="text" name="qInstrument" placeholder="Instrument"/>

    <label for="tLeader" >Leader?</label>
    <select name="tLeader">
      <option value="">Both</option>
      <option value="true">Yes</option>
      <option value="false">No</option>
    </select>

    <button type="submit">Search</button>
  </form>

  <% if (qRes) {%>
    <%- include('./partials/qResultTable.ejs')%> 
  <% } %> 
</body>
</html>