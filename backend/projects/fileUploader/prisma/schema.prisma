// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int     @id @default(autoincrement())
  username    String  @unique
  firstName   String
  lastName    String
  password    String
  files       File[]
  folders     Folder[]
}

model File {
  id          Int       @id @default(autoincrement())
  name        String
  path        String    // cloud URL
  size        Int       // bytes
  uploadedAt  DateTime  @default(now())  
  ownerId     Int
  folderId    Int
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  folder      Folder    @relation(fields: [folderId], references: [id], onDelete: Cascade)
}

model Folder {
  id          Int       @id @default(autoincrement())
  files       File[]
  name        String
  path        String    // parentId/id
  createdAt   DateTime  @default(now())
  ownerId     Int
  parentId    Int?       
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parent      Folder?   @relation("FolderRelation", fields: [parentId], references: [id], onDelete: Cascade)
  children    Folder[]  @relation("FolderRelation")

  @@unique([ownerId, parentId, name])
}

model Session {
  id          String    @id
  sid         String    @unique
  data        String
  expiresAt   DateTime
}

// Migration Workflow:
// npx prisma migrate dev --name <commit_name>
// npx prisma generate
